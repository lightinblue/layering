{
  "expo": {
    "name": "레이어링",
    "slug": "layering",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "layering",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.lightinblue.layering",
      "appleTeamId": "R39JVZ3ZNL",
      "buildNumber": "9",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "레이어링",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.lightinblue.layering.poogae"
        ]
      }
    },
    "android": {
      "package": "com.lightinblue.layering",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "storeDisplayName": "레이어링 - 규칙적인 복습 스케줄러",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3436de6a-5b18-4852-b433-06d9f0038c30"
      }
    },
    "owner": "syyoonn"
  }
}
