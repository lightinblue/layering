{
  "expo": {
    "name": "레이어링 - 규칙적인 복습 스케줄러",
    "slug": "layering",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "layering",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.lightinblue.layering",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "레이어링"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
